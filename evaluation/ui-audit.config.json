        {
          "eval": "window.__TEST__.rig.flyTo(window.__TEST__.views.safetyWall, 0.05)"
        },
        {
          "wait": 3000
        }
      ]
    },
    {
      "name": "walk-staging",
      "label": "Look over the staging lane",
      "steps": [
        {
          "eval": "window.__TEST__.rig.flyTo(window.__TEST__.views.staging, 0.05)"
        },
        {
          "wait": 3000
        }
      ]
