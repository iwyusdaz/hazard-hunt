    {
      "name": "m2-areas",
      "label": "Module 2: the areas list drawer",
      "steps": [
        {
          "eval": "document.querySelectorAll('[data-ui=module-step]')[1].click()"
        },
        {
          "wait": 2500
        },
        {
          "eval": "[...document.querySelectorAll('[data-ui=now-card] button')].find((b) => b.textContent.trim() === 'List the areas to judge').click()"
        },
        {
          "wait": 1500
        }
      ]
    },
    {
      "name": "m2-judge",
      "label": "Module 2: the judge form for the spill",
      "steps": [
        {
          "eval": "window.__TEST__.shell.closeDrawer(); window.__TEST__.inspect.open('hazard-spill')"
        },
        {
          "wait": 2000
        },
        {
          "eval": "[...document.querySelectorAll('[data-ui=info-card] button')].find((b) => b.textContent.trim() === 'Judge this area').click()"
        },
        {
          "wait": 1500
        }
      ]
    },
    {
      "name": "m3-replay",
      "label": "Module 3: the replay playing (segment 2)",
      "steps": [
        {
          "eval": "window.__TEST__.shell.closeDrawer(); document.querySelectorAll('[data-ui=module-step]')[2].click()"
        },
        {
          "wait": 2500
        },
        {
          "eval": "[...document.querySelectorAll('[data-ui=now-card] button')].find((b) => b.textContent.trim() === 'Start the replay').click()"
        },
        {
          "wait": 2000
        },
        {
          "eval": "window.__TEST__.lessons.replay.load(1); window.__TEST__.lessons.replay.play(); window.__TEST__.lessons.refresh()"
        },
