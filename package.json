{
  "name": "hazard-hunt",
  "private": true,
  "version": "3.0.1",
  "type": "module",
  "description": "A three.js workplace safety mini course: spot warehouse hazards in realistic 3D, replay a near-miss, and practice speaking up",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-attribution.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:subpath": "npm run build && SLUG=hazard-hunt playwright test tests/sub-path.spec.js",
    "check:a11y": "playwright test tests/a11y.spec.js",
    "poster": "node scripts/render-poster.mjs dock",
    "validate:showcase": "node scripts/validate-showcase.mjs 3.0.0",
    "make:lut": "node scripts/make-lut.mjs bay4-night",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
